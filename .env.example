# Public, nonsecret location of the read-only Stage 8 service.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# For deployment, use the approved HTTPS API origin at BUILD time (Vercel Production and Preview).
# APP_ENV=production enables the same deployment guard outside Vercel.
# Do not put database credentials or private release storage keys in NEXT_PUBLIC_ variables.
