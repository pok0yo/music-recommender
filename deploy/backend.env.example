# Server-side values only. Copy actual values into Render secrets, never into Git or the browser.
# Copy the IPv4 Session pooler host from Supabase Connect; do not derive it from a region name.
DATABASE_URL=postgresql://music_reader.PROJECT_REF:PRIVATE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system
ALLOWED_ORIGINS=https://YOUR_APPROVED_FRONTEND.vercel.app
# Private bucket; upload each file under the release ID in deploy/release.json.
RELEASE_STORAGE_BASE_URL=https://PROJECT_REF.supabase.co/storage/v1/object/authenticated/model-releases/RELEASE_ID
# Dedicated sb_secret_ key: privileged across this isolated project, not a read-only bucket credential.
# Used by the build fetcher; Render also exposes service environment values to the runtime.
RELEASE_STORAGE_TOKEN=sb_secret_PRIVATE_SERVER_STORAGE_KEY
# Operator machine only, never configure this on the API service:
# CATALOG_ADMIN_DATABASE_URL=postgresql://postgres.PROJECT_REF:PRIVATE_ADMIN_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system
