{
  "components": {
    "schemas": {
      "ArtistCredit": {
        "properties": {
          "artist_id": {
            "format": "uuid",
            "title": "Artist Id",
            "type": "string"
          },
          "joinphrase": {
            "default": "",
            "title": "Joinphrase",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "artist_id"
        ],
        "title": "ArtistCredit",
        "type": "object"
      },
      "CatalogResponse": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results",
          "meta"
        ],
        "title": "CatalogResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ListeningLink": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "enum": [
              "spotify",
              "apple_music",
              "youtube_music"
            ],
            "title": "Provider",
            "type": "string"
          },
          "url": {
            "maxLength": 2048,
            "title": "Url",
            "type": "string"
          },
          "verification": {
            "const": "recording_relationship_and_destination",
            "title": "Verification",
            "type": "string"
          },
          "verified_at": {
            "format": "date-time",
            "title": "Verified At",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "url",
          "verified_at",
          "verification"
        ],
        "title": "ListeningLink",
        "type": "object"
      },
      "Meta": {
        "properties": {
          "artifact_schema_version": {
            "title": "Artifact Schema Version",
            "type": "integer"
          },
          "catalog_version": {
            "title": "Catalog Version",
            "type": "string"
          },
          "data_mode": {
            "enum": [
              "real",
              "demo"
            ],
            "title": "Data Mode",
            "type": "string"
          },
          "method": {
            "const": "item_cosine_shared_listener_shrinkage",
            "default": "item_cosine_shared_listener_shrinkage",
            "title": "Method",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "training_cutoff": {
            "const": "2026-08-01T00:00:00Z",
            "default": "2026-08-01T00:00:00Z",
            "title": "Training Cutoff",
            "type": "string"
          }
        },
        "required": [
          "model_version",
          "catalog_version",
          "artifact_schema_version",
          "data_mode"
        ],
        "title": "Meta",
        "type": "object"
      },
      "RecommendationResponse": {
        "properties": {
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Alternatives",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "model_result_count": {
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Model Result Count",
            "type": "integer"
          },
          "omitted_metadata_count": {
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Omitted Metadata Count",
            "type": "integer"
          },
          "requested_limit": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Requested Limit",
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RelatedTrack"
            },
            "title": "Results",
            "type": "array"
          },
          "seed": {
            "$ref": "#/components/schemas/Track"
          },
          "status": {
            "enum": [
              "ok",
              "limited",
              "no_connections"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "seed",
          "results",
          "status",
          "omitted_metadata_count",
          "model_result_count",
          "requested_limit",
          "meta"
        ],
        "title": "RecommendationResponse",
        "type": "object"
      },
      "RelatedTrack": {
        "additionalProperties": false,
        "properties": {
          "artist_credits": {
            "items": {
              "$ref": "#/components/schemas/ArtistCredit"
            },
            "minItems": 1,
            "title": "Artist Credits",
            "type": "array"
          },
          "candidate_training_listeners": {
            "minimum": 5.0,
            "title": "Candidate Training Listeners",
            "type": "integer"
          },
          "canonical_recording_id": {
            "format": "uuid",
            "title": "Canonical Recording Id",
            "type": "string"
          },
          "disambiguation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disambiguation"
          },
          "explanation": {
            "default": "Connected through shared listening in this dataset.",
            "title": "Explanation",
            "type": "string"
          },
          "external_link": {
            "title": "External Link",
            "type": "null"
          },
          "listening_links": {
            "items": {
              "$ref": "#/components/schemas/ListeningLink"
            },
            "maxItems": 3,
            "title": "Listening Links",
            "type": "array"
          },
          "rank": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Rank",
            "type": "integer"
          },
          "reason_code": {
            "const": "shared_listeners",
            "default": "shared_listeners",
            "title": "Reason Code",
            "type": "string"
          },
          "recording_id": {
            "format": "uuid",
            "title": "Recording Id",
            "type": "string"
          },
          "seed_training_listeners": {
            "minimum": 5.0,
            "title": "Seed Training Listeners",
            "type": "integer"
          },
          "shared_training_listeners": {
            "minimum": 3.0,
            "title": "Shared Training Listeners",
            "type": "integer"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "recording_id",
          "canonical_recording_id",
          "title",
          "artist_credits",
          "disambiguation",
          "rank",
          "shared_training_listeners",
          "seed_training_listeners",
          "candidate_training_listeners"
        ],
        "title": "RelatedTrack",
        "type": "object"
      },
      "Track": {
        "additionalProperties": false,
        "properties": {
          "artist_credits": {
            "items": {
              "$ref": "#/components/schemas/ArtistCredit"
            },
            "minItems": 1,
            "title": "Artist Credits",
            "type": "array"
          },
          "canonical_recording_id": {
            "format": "uuid",
            "title": "Canonical Recording Id",
            "type": "string"
          },
          "disambiguation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disambiguation"
          },
          "external_link": {
            "title": "External Link",
            "type": "null"
          },
          "listening_links": {
            "items": {
              "$ref": "#/components/schemas/ListeningLink"
            },
            "maxItems": 3,
            "title": "Listening Links",
            "type": "array"
          },
          "recording_id": {
            "format": "uuid",
            "title": "Recording Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "recording_id",
          "canonical_recording_id",
          "title",
          "artist_credits",
          "disambiguation"
        ],
        "title": "Track",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Music discovery API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Live"
      }
    },
